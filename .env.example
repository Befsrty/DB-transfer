# Скопируй файл в .env (cp .env.example .env) и при желании поменяй значения.
# .env не попадает в git: пароль остаётся только на твоём компьютере.
# Эти же переменные читает docker-compose.yml, поэтому база и приложение настроены одинаково.

DBT_DB_HOST=localhost
# Если порт 5432 уже занят (например, локальным PostgreSQL), поставь 5433
DBT_DB_PORT=5432
DBT_DB_NAME=demo
DBT_DB_USER=gpadmin
DBT_DB_PASSWORD=student
