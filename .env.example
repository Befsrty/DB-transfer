# Файл копируется в .env (cp .env.example .env), значения при необходимости меняются.
# .env не попадает в git: пароль остаётся только на локальном компьютере.
# Эти же переменные читает docker-compose.yml, поэтому база и приложение настроены одинаково.

DBT_DB_HOST=localhost
# Порт на локальном компьютере. Не 5432, чтобы не попасть в локальный PostgreSQL, если он установлен.
# Если 15432 тоже занят, нужно указать любой свободный, например 25432.
DBT_DB_PORT=15432
DBT_DB_NAME=demo
DBT_DB_USER=gpadmin
DBT_DB_PASSWORD=student
